{
  "name": "obs-plugin-radio",
  "version": "1.0.0",
  "description": "Panel de control para OBS que maneja butt.exe a través de radio-agent",
  "scripts": {
    "build": "concurrently \"node esbuild.config.js\" \"tailwindcss -i ./css/input.css -o ./dist/output.css --minify\"",
    "watch": "concurrently \"node esbuild.config.js --watch\" \"tailwindcss -i ./css/input.css -o ./dist/output.css --watch\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juanes7222/OBS-Plugin-Radio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Juanes7222/OBS-Plugin-Radio/issues"
  },
  "homepage": "https://github.com/Juanes7222/OBS-Plugin-Radio#readme",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "daisyui": "^4.12.24",
    "esbuild": "0.27.4",
    "tailwindcss": "^3.4.19"
  }
}
